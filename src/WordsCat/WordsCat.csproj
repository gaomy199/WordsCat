<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\wordscat.ico</ApplicationIcon>
    <AssemblyName>WordsCat</AssemblyName>
    <RootNamespace>ReadDock</RootNamespace>
    <Version>0.3.4</Version>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">8.0.33</RuntimeFrameworkVersion>
    <Company>WordsCat</Company>
    <Product>单词猫 WordsCat</Product>
    <Description>中英互译与 Obsidian 生词收藏</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\wordscat.ico" LogicalName="WordsCat.DefaultIcon" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <Content Include="..\..\assets\math\**\*" Link="assets\math\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\scripts\ocr.ps1" Link="ocr.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\templates\vocabulary.template.json" Link="vocabulary.template.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\USER_GUIDE*.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
